<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed by the SDK itself to download the models on init. Apps that already hold
         these permissions (most apps with online features) need to add nothing; the
         manifest merger adds them to the consuming app automatically. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

</manifest>
